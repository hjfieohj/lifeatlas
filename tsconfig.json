{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
    ,"jsx": "react-jsx", "esModuleInterop": true, "resolveJsonModule": true,
    "types": ["node", "@cloudflare/workers-types"], "paths": {"@/*": ["./*"]}
  },
  "include": ["src", "server", "app", "db", "cloudflare-env.d.ts"],
  "exclude": ["node_modules", "tests"]
}
