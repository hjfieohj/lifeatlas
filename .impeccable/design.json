  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared native action; skin variables inherit through the shadow boundary.",
      "html": "<button type=\"button\" class=\"ds-button ds-primary\">保存设置</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:10px 17px;border:1px solid transparent;border-radius:8px;min-height:42px;font:500 13px/1.7 'Microsoft YaHei','PingFang SC',system-ui,sans-serif;cursor:pointer;transition:background .15s}.ds-button:disabled{opacity:.45;cursor:not-allowed}.ds-button:focus-visible,.ds-input:focus-visible,.ds-nav a:focus-visible,.ds-appearance select:focus-visible,.ds-appearance input:focus-visible{outline:3px solid var(--focus,#286b78);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-primary{background:var(--forest,#286b78);color:var(--accent-ink,#fff)}.ds-primary:hover:not(:disabled){background:var(--forest-deep,#205562)}"
    },
    {
      "name": "Subtle button",
      "kind": "button",
      "refersTo": "button-subtle",
      "description": "Shared native action; skin variables inherit through the shadow boundary.",
      "html": "<button type=\"button\" class=\"ds-button ds-subtle\">保存设置</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:10px 17px;border:1px solid transparent;border-radius:8px;min-height:42px;font:500 13px/1.7 'Microsoft YaHei','PingFang SC',system-ui,sans-serif;cursor:pointer;transition:background .15s}.ds-button:disabled{opacity:.45;cursor:not-allowed}.ds-button:focus-visible,.ds-input:focus-visible,.ds-nav a:focus-visible,.ds-appearance select:focus-visible,.ds-appearance input:focus-visible{outline:3px solid var(--focus,#286b78);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-subtle{background:var(--surface,#fbfdfd);color:var(--ink,#233c46);border-color:var(--secondary-border,#b4c7ce)}.ds-subtle:hover:not(:disabled){background:var(--wash,#e1ecef)}"
    },
    {
      "name": "Danger button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Shared native action; skin variables inherit through the shadow boundary.",
      "html": "<button type=\"button\" class=\"ds-button ds-danger\">清除演示记录</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:10px 17px;border:1px solid transparent;border-radius:8px;min-height:42px;font:500 13px/1.7 'Microsoft YaHei','PingFang SC',system-ui,sans-serif;cursor:pointer;transition:background .15s}.ds-button:disabled{opacity:.45;cursor:not-allowed}.ds-button:focus-visible,.ds-input:focus-visible,.ds-nav a:focus-visible,.ds-appearance select:focus-visible,.ds-appearance input:focus-visible{outline:3px solid var(--focus,#286b78);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-danger,.ds-danger:hover{background:var(--red-bg,#f8e7e4);color:var(--red,#943d38)}"
    },
    {
      "name": "Text field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Labeled growth field; search has a separate inline-icon wrapper in the app.",
      "html": "<label class=\"ds-label\">主题名称<input class=\"ds-input\" placeholder=\"写下你想持续观察的事\"></label>",
      "css": ".ds-label{display:grid;gap:9px;font-size:15px;font-family:'Microsoft YaHei','PingFang SC',system-ui,sans-serif;color:var(--ink,#233c46);}.ds-input{width:100%;min-width:0;padding:10px 12px;border:1px solid var(--secondary-border,#b4c7ce);border-radius:6px;background:var(--surface,#fbfdfd);font:15px/1.9 'Microsoft YaHei', 'PingFang SC', system-ui, sans-serif;color:var(--ink,#233c46);caret-color:var(--green,#286b78)}.ds-input::placeholder{color:var(--muted,#526873);opacity:1}.ds-button:focus-visible,.ds-input:focus-visible,.ds-nav a:focus-visible,.ds-appearance select:focus-visible,.ds-appearance input:focus-visible{outline:3px solid var(--focus,#286b78);outline-offset:4px}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Shared active/hover states; specimen displays the five existing destinations.",
      "html": "<nav class=\"ds-nav\" aria-label=\"主导航\"><a href=\"#today\">今日</a><a href=\"#mail\">邮箱整理</a><a href=\"#growth\" aria-current=\"page\">个人成长</a><a href=\"#history\">任务记录</a><a href=\"#settings\">偏好设置</a></nav>",
      "css": ".ds-nav{display:flex;flex-wrap:wrap;gap:8px;padding:12px;background:var(--nav,#f3f7f7);font-family:'Microsoft YaHei','PingFang SC',system-ui,sans-serif;color:var(--ink,#233c46);}.ds-nav a{font-size:14px;padding:12px;border-radius:9px;text-decoration:none;color:var(--muted,#526873);transition:background .15s,color .15s}.ds-nav a[aria-current]{color:var(--green,#286b78);background:var(--nav-active-bg,#dcebef);font-weight:600}.ds-nav a:hover:not([aria-current]){color:var(--ink,#233c46);background:var(--wash,#e1ecef)}.ds-button:focus-visible,.ds-input:focus-visible,.ds-nav a:focus-visible,.ds-appearance select:focus-visible,.ds-appearance input:focus-visible{outline:3px solid var(--focus,#286b78);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-nav a{transition:none}}"
    },
    {
      "name": "Pending chip",
      "kind": "chip",
      "refersTo": "status-awaiting",
      "description": "Informational status with text; no invented interaction.",
      "html": "<span class=\"ds-chip\">待确认</span>",
      "css": ".ds-chip{display:inline-block;padding:4px 9px;border-radius:4px;background:var(--amber-bg,#f1e8d7);color:var(--amber,#785424);font:10px/1.65 'Microsoft YaHei', 'PingFang SC', system-ui, sans-serif}"
    },
    {
      "name": "Reading panel",
      "kind": "card",
      "refersTo": "growth-reading-panel",
      "description": "Opaque shared reading surface; static specimen contains no personal record.",
      "html": "<section class=\"ds-reading\"><h2>个人成长</h2><p>写下经历，再回看理解如何变化。</p></section>",
      "css": ".ds-reading{background:var(--surface,#fbfdfd);border-radius:var(--radius,14px);padding:28px 32px;font-family:'Microsoft YaHei','PingFang SC',system-ui,sans-serif;color:var(--ink,#233c46);}.ds-reading h2{font-size:25px;line-height:1.65;margin:0 0 16px;font-weight:600}.ds-reading p{font-size:16px;line-height:2;margin:0;max-width:70ch}"
    },
    {
      "name": "Appearance controls",
      "kind": "custom",
      "refersTo": "button-subtle",
      "description": "Native controls specimen; synchronization and persistence require appearance.ts.",
      "html": "<div class=\"ds-appearance\"><label>皮肤 <select aria-label=\"选择皮肤\"><option>晨光 · 生活静室</option><option>星夜 · 成长轨迹</option><option>石墨 · 生活舱</option></select></label><label><input type=\"checkbox\" checked> 粒子动态</label></div>",
      "css": ".ds-appearance{display:flex;align-items:center;flex-wrap:wrap;gap:12px 20px;font-size:13px;font-family:'Microsoft YaHei','PingFang SC',system-ui,sans-serif;color:var(--ink,#233c46);}.ds-appearance label{display:inline-flex;align-items:center;gap:8px;min-height:40px;color:var(--muted,#526873)}.ds-appearance select{max-width:100%;min-height:40px;border:1px solid var(--secondary-border,#b4c7ce);border-radius:7px;padding:6px 28px 6px 10px;background:var(--surface,#fbfdfd);color:var(--ink,#233c46);font:13px 'Microsoft YaHei', 'PingFang SC', system-ui, sans-serif}.ds-appearance input{width:16px;height:16px;margin:0;accent-color:var(--green,#286b78)}.ds-button:focus-visible,.ds-input:focus-visible,.ds-nav a:focus-visible,.ds-appearance select:focus-visible,.ds-appearance input:focus-visible{outline:3px solid var(--focus,#286b78);outline-offset:4px}"
    }
