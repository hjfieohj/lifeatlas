  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary-island",
      "description": "Live-bound to either palette; the specimen fallback is Island.",
      "html": "<button class=\"ds-button\">保存记录</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:44px;border:1px solid transparent;border-radius:8px;padding:10px 16px;font-size:13px;line-height:1.7;font-weight:500;cursor:pointer;transition:background .15s;font-family:'Microsoft YaHei','PingFang SC',system-ui,sans-serif;background:var(--forest,#4b5db4);border-color:var(--forest,#4b5db4);color:var(--accent-ink,#fff)}.ds-button:hover:not(:disabled){background:var(--forest-deep,#3b4b98);border-color:var(--forest-deep,#3b4b98)}.ds-button:focus-visible{outline:3px solid var(--focus,#4b5db4);outline-offset:4px}.ds-button:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}"
    },
    {
      "name": "Subtle action",
      "kind": "button",
      "refersTo": "button-subtle",
      "description": "White secondary native action with a visible border.",
      "html": "<button class=\"ds-subtle\">取消</button>",
      "css": ".ds-subtle{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:44px;border:1px solid transparent;border-radius:8px;padding:10px 16px;font-size:13px;line-height:1.7;font-weight:500;cursor:pointer;transition:background .15s;font-family:'Microsoft YaHei','PingFang SC',system-ui,sans-serif;background:var(--surface,#fff);color:var(--ink,#273c59);border-color:var(--secondary-border,#becadd)}.ds-subtle:hover:not(:disabled){background:var(--wash,#eef2f9)}.ds-subtle:focus-visible{outline:3px solid var(--focus,#4b5db4);outline-offset:4px}.ds-subtle:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-subtle{transition:none}}"
    },
    {
      "name": "Growth text field",
      "kind": "input",
      "refersTo": "input",
      "description": "Native text entry, with persistence supplied by the application.",
      "html": "<label class=\"ds-label\">下一步<textarea class=\"ds-input\" placeholder=\"写下一个可以尝试的小行动\"></textarea></label>",
      "css": ".ds-label{display:block;font-size:14px;line-height:1.85;color:var(--ink,#273c59);font-family:'Microsoft YaHei','PingFang SC',system-ui,sans-serif;}.ds-input{display:block;width:100%;margin-top:8px;min-height:100px;border:1px solid var(--secondary-border,#becadd);border-radius:8px;padding:11px 12px;background:var(--surface,#fff);color:var(--ink,#273c59);font:15px/1.85 'Microsoft YaHei','PingFang SC',system-ui,sans-serif;resize:vertical;caret-color:var(--green,#4b5db4)}.ds-input::placeholder{color:var(--muted,#5f6f87);opacity:1}.ds-input:focus-visible{outline:3px solid var(--focus,#4b5db4);outline-offset:4px}@media(max-width:640px){.ds-input{font-size:16px}}"
    },
    {
      "name": "Shared app navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Desktop state specimen; both palettes share the rail. Real routing remains in the app.",
      "html": "<nav class=\"ds-nav\" aria-label=\"主导航\"><a href=\"#today\">今日</a><a href=\"#growth\" aria-current=\"page\">个人成长<br><small>环境感知</small></a><a href=\"#mail\">邮箱整理</a><a href=\"#history\">任务记录</a><a href=\"#settings\">偏好设置</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:7px;width:176px;padding:16px;background:var(--nav,#273c59);font-family:'Microsoft YaHei','PingFang SC',system-ui,sans-serif;}.ds-nav a{display:block;min-height:49px;padding:12px;border-radius:9px;color:var(--rail-ink,#e8edf7);font-size:14px;line-height:1.6;text-decoration:none}.ds-nav small{font-size:12px;font-weight:400}.ds-nav a[aria-current]{color:#fff;background:var(--rail-active,#40577b);font-weight:600}.ds-nav a:hover:not([aria-current]){background:var(--rail-active,#40577b);color:#fff}.ds-nav a:focus-visible{outline:3px solid var(--focus,#4b5db4);outline-offset:4px}@media(max-width:820px){.ds-nav{width:auto;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px}.ds-nav a{font-size:12px;padding:10px 4px;text-align:center}}"
    },
    {
      "name": "Topic index selection",
      "kind": "custom",
      "refersTo": "topic-active",
      "description": "A flat independent index, without another enclosing card.",
      "html": "<nav class=\"ds-topics\" aria-label=\"成长主题\"><button>演示主题一（虚构）</button><button aria-current=\"page\">演示主题二（虚构）</button></nav>",
      "css": ".ds-topics{display:flex;flex-direction:column;gap:5px;width:186px;font-family:'Microsoft YaHei','PingFang SC',system-ui,sans-serif;}.ds-topics button{width:100%;min-height:46px;background:transparent;border:0;border-radius:9px;padding:13px 11px;text-align:left;font:13px/1.85 'Microsoft YaHei','PingFang SC',system-ui,sans-serif;color:var(--muted,#5f6f87);cursor:pointer;overflow-wrap:anywhere}.ds-topics button[aria-current]{background:var(--nav-active-bg,#e1e7f6);color:var(--green,#4b5db4);font-weight:600}.ds-topics button:hover:not([aria-current]){background:var(--wash,#eef2f9);color:var(--ink,#273c59)}.ds-topics button:focus-visible{outline:3px solid var(--focus,#4b5db4);outline-offset:3px}"
    },
    {
      "name": "Pending status",
      "kind": "chip",
      "refersTo": "status-awaiting",
      "description": "Noninteractive status with explicit written meaning.",
      "html": "<span class=\"ds-status\">待确认</span>",
      "css": ".ds-status{display:inline-block;padding:4px 8px;border-radius:5px;background:var(--amber-bg,#fff3e3);color:var(--amber,#8a5426);font-size:12px;line-height:1.8;font-family:'Microsoft YaHei','PingFang SC',system-ui,sans-serif;}"
    },
    {
      "name": "Continuous reading sheet",
      "kind": "card",
      "refersTo": "growth-reading-sheet",
      "description": "One opaque sheet, with flat ruled content rather than nested cards.",
      "html": "<section class=\"ds-sheet\"><h2>个人成长</h2><p>写下经历，再回看理解如何变化。</p><details><summary>观察、理解与尝试</summary><p>次要内容按需展开。</p></details></section>",
      "css": ".ds-sheet{background:var(--surface,#fff);color:var(--ink,#273c59);padding:26px 28px;border-radius:14px;box-shadow:var(--shadow,0 12px 38px #263e6610);font-family:'Microsoft YaHei','PingFang SC',system-ui,sans-serif;}.ds-sheet h2{font-size:20px;font-weight:600;line-height:1.75;margin:0 0 20px}.ds-sheet p{font-size:16px;line-height:1.95;margin:0;max-width:70ch}.ds-sheet details{margin-top:22px;padding-top:12px;border-top:1px solid var(--line,#e0e6f0)}.ds-sheet summary{padding:9px 0;color:var(--green,#4b5db4);font-size:13px;cursor:pointer}.ds-sheet summary:hover{text-decoration:underline}.ds-sheet summary:focus-visible{outline:3px solid var(--focus,#4b5db4);outline-offset:3px}.ds-sheet details p{font-size:14px}@media(max-width:640px){.ds-sheet{padding:22px 18px}}"
    },
    {
      "name": "Appearance controls",
      "kind": "custom",
      "refersTo": "input",
      "description": "Exactly two palette choices; the app supplies synchronization and particle stop rules.",
      "html": "<div class=\"ds-appearance\"><label>皮肤 <select aria-label=\"选择皮肤\"><option value=\"island\">光屿工作台</option><option value=\"observatory\">对页观察室</option></select></label><label><input type=\"checkbox\"> 粒子动态</label></div>",
      "css": ".ds-appearance{display:flex;flex-wrap:wrap;align-items:center;gap:12px 16px;font-size:12px;font-family:'Microsoft YaHei','PingFang SC',system-ui,sans-serif;}.ds-appearance label{display:inline-flex;align-items:center;gap:8px;min-height:40px;color:var(--muted,#5f6f87)}.ds-appearance select{max-width:100%;min-height:36px;border:1px solid var(--secondary-border,#becadd);border-radius:8px;padding:5px 26px 5px 10px;background:var(--surface,#fff);color:var(--ink,#273c59);font:inherit}.ds-appearance input{width:16px;height:16px;accent-color:var(--green,#4b5db4)}.ds-appearance select:focus-visible,.ds-appearance input:focus-visible{outline:3px solid var(--focus,#4b5db4);outline-offset:4px}@media(max-width:640px){.ds-appearance{font-size:13px}.ds-appearance select{min-height:44px}}"
    },
    {
      "name": "Facing periods",
      "kind": "custom",
      "refersTo": "comparison-cool",
      "description": "Earlier/later labels only; real excerpts come from authored records.",
      "html": "<div class=\"ds-compare\"><section><h3>较早记录</h3><p>经历与反省</p></section><section><h3>较近记录</h3><p>经历与反省</p></section></div>",
      "css": ".ds-compare{display:grid;grid-template-columns:1fr 1fr;gap:20px;color:var(--ink,#273c59);font-family:'Microsoft YaHei','PingFang SC',system-ui,sans-serif;}.ds-compare section{min-width:0;padding:20px;border-radius:12px;background:var(--wash,#eef2f9)}.ds-compare section+section{background:#faf4ec}.ds-compare h3{font-size:14px;line-height:1.8;color:var(--green,#4b5db4);margin:0 0 12px}.ds-compare p{font-family:AtlasSerif,'Noto Serif SC',serif;font-size:18px;line-height:1.95;margin:0;overflow-wrap:anywhere}@media(max-width:640px){.ds-compare{grid-template-columns:1fr;gap:18px}.ds-compare section{padding:20px 16px}}"
    }
  ],
  "narrative": {
    "northStar": "生活阅览室",
    "overview": "生活阅览室 is the user-selected replacement visual world, adopted on 2026-10-30. A deep blue navigation rail, an independent topic index and a continuous white reading sheet give locating, reading and acting distinct places. This shared layout now serves both 光屿工作台 (Island, default) and 对页观察室 (Observatory); their selectable color identities remain.\n\nThe same authored records, native controls and five destinations serve both palettes. Quiet hierarchy and progressive disclosure reduce nested card framing while keeping versions, uncertainty and sources findable. A skin change preserves live work; atmosphere does not supply personal history or interpretation.",
    "keyCharacteristics": [
      "One shared reading-room layout with two selectable palettes.",
      "A flat topic index beside an opaque, continuous reading sheet.",
      "Chinese sans titles and controls; serif comparison excerpts and the existing brand.",
      "Independent particles with the existing pause and preference behavior."
    ],
    "rules": [
      {
        "name": "The Textual State Rule",
        "body": "Every consequential status has a written label; color is an additional cue.",
        "section": "colors"
      },
      {
        "name": "The Index and Sheet Rule",
        "body": "The topic index locates; the white sheet carries reading. Use dividers and disclosures inside the sheet rather than another stack of equal-weight cards.",
        "section": "elevation"
      },
      {
        "name": "The Live Task Rule",
        "body": "Changing appearance preserves live input, focus, scroll and the current view by updating the document skin attribute.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use the active palette’s semantic CSS variables across all five destinations.",
      "Do keep topic lookup separate from continuous reading and secondary tools in native disclosures.",
      "Do lead comparison with event and reflection; keep observation, feedback and action in expandable details.",
      "Do preserve native control semantics, explicit saving, visible keyboard focus and reduced-motion behavior.",
      "Do distinguish fictional demonstrations from real authored records and report the actual viewport limits of visual review."
    ],
    "donts": [
      "Don't restore the superseded horizontal Observatory desktop shell or lake banner as the current layout authority.",
      "Don't add retired skins to the selector or canonical palette.",
      "Don't remount the live route to change appearance.",
      "Don't put reading text on a transparent particle layer.",
      "Don't turn examples, scenery, counts or unimplemented analysis into personal data or capability claims."
    ]
  }
}
