  "components": [
    {
      "name": "Primary Action",
      "kind": "button",
      "refersTo": "button-primary-island",
      "description": "The main explicit action; inherits the current skin.",
      "html": "<button class=\"ds-primary\">保存记录</button>",
      "css": ".ds-primary{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei','PingFang SC',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:10px 18px;border:0;border-radius:30px;font-size:13px;font-weight:500;line-height:1.6;transition:background-color 160ms,transform 160ms cubic-bezier(.16,1,.3,1);background:var(--forest,#0a67d7);color:var(--accent-ink,#fff);box-shadow:0 3px 8px #00449a18}.ds-primary:hover{background:var(--forest-deep,#0874ee)}.ds-primary:active{transform:scale(.97)}.ds-primary:disabled{opacity:.5;cursor:not-allowed}.ds-primary:focus-visible{outline:2px solid var(--focus,#8dbbff);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Secondary Action",
      "kind": "button",
      "refersTo": "button-subtle",
      "description": "A quiet neutral capsule.",
      "html": "<button class=\"ds-subtle\">新建一条</button>",
      "css": ".ds-subtle{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei','PingFang SC',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:10px 18px;border:0;border-radius:30px;font-size:13px;font-weight:500;line-height:1.6;transition:background-color 160ms,transform 160ms cubic-bezier(.16,1,.3,1);background:var(--control,#ffffff10);color:var(--ink,#f2f3f7)}.ds-subtle:hover{background:var(--control-hover,#ffffff1c)}.ds-subtle:active{transform:scale(.97)}.ds-subtle:focus-visible{outline:2px solid var(--focus,#8dbbff);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-subtle{transition:none}}"
    },
    {
      "name": "Native Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "A filled native field with a visible keyboard halo.",
      "html": "<label class=\"ds-label\">标题<input class=\"ds-field\" placeholder=\"研究对象与要验证的问题\"></label>",
      "css": ".ds-label{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei','PingFang SC',sans-serif;display:grid;gap:8px;font-size:12px;color:var(--ink,#f2f3f7)}.ds-field{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei','PingFang SC',sans-serif;min-height:44px;padding:11px 12px;border:1px solid transparent;border-radius:11px;background:var(--field,#141720);color:var(--ink,#f2f3f7);font-size:14px;line-height:1.65;transition:border-color 150ms}.ds-field::placeholder{color:var(--muted,#b1b5c2);opacity:1}.ds-field:focus-visible{outline:3px solid color-mix(in srgb,var(--focus,#8dbbff) 35%,transparent);outline-offset:2px;border-color:var(--focus,#8dbbff)}"
    },
    {
      "name": "Selected Navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Drawn blue icon on a neutral selected tile.",
      "html": "<nav class=\"ds-nav\"><button class=\"ds-nav-item\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5\"/></svg>今日</button></nav>",
      "css": ".ds-nav-item{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei','PingFang SC',sans-serif;display:flex;align-items:center;gap:12px;min-height:46px;padding:10px 13px;border:0;border-radius:12px;background:var(--rail-active,#ffffff14);color:var(--ink,#f2f3f7);font-size:13px;font-weight:600;transition:background-color 160ms}.ds-nav-item svg{color:var(--green,#86b9ff)}.ds-nav-item:hover{background:var(--control-hover,#ffffff1c)}.ds-nav-item:focus-visible{outline:2px solid var(--focus,#8dbbff);outline-offset:4px}"
    },
    {
      "name": "Local Saving Chip",
      "kind": "chip",
      "refersTo": "status-chip",
      "description": "Written local-save state.",
      "html": "<span class=\"ds-chip\" role=\"status\">本机保存</span>",
      "css": ".ds-chip{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei','PingFang SC',sans-serif;display:inline-block;border-radius:30px;padding:8px 13px;background:var(--glass,#242833d9);color:var(--ink,#f2f3f7);font-size:11px;line-height:1.5}"
    },
    {
      "name": "Continuous Reading Surface",
      "kind": "card",
      "refersTo": "reading-sheet",
      "description": "One stable work area, divided record rows.",
      "html": "<section class=\"ds-sheet\"><h2>我的记录</h2><article class=\"ds-record\"><h3>留下一个研究判断</h3><p>保留依据、来源与之后要验证的问题。</p></article><article class=\"ds-record\"><h3>记录一次经历</h3><p>保留当时的环境与理解。</p></article></section>",
      "css": ".ds-sheet{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei','PingFang SC',sans-serif;padding:26px 28px;border-radius:16px;background:var(--surface,#20232cf5);color:var(--ink,#f2f3f7);box-shadow:var(--work-elevation,0 10px 32px #00000018)}.ds-sheet h2{font-size:19px;font-weight:650;margin:0 0 20px}.ds-record{padding:23px 0;border-bottom:1px solid var(--line,#ffffff17)}.ds-record:last-child{border-bottom:0}.ds-record h3{font-size:17px;font-weight:600;line-height:1.7;margin:4px 0 12px}.ds-record p{font-size:14px;line-height:1.9;max-width:72ch;margin:0}"
    },
    {
      "name": "Segmented View",
      "kind": "custom",
      "refersTo": "segment-active",
      "description": "A softly raised neutral selection.",
      "html": "<div class=\"ds-track\"><button class=\"ds-segment\" aria-pressed=\"true\">经历时间线</button><button class=\"ds-segment\" aria-pressed=\"false\">对照回看</button></div>",
      "css": ".ds-track{display:inline-flex;gap:3px;padding:4px;border-radius:30px;background:var(--control,#ffffff10)}.ds-segment{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei','PingFang SC',sans-serif;min-height:36px;padding:8px 16px;border:0;border-radius:24px;background:transparent;color:var(--muted,#b1b5c2);font-size:12px;font-weight:500}.ds-segment[aria-pressed=true]{background:var(--selected,#3c404d);color:var(--ink,#f2f3f7);box-shadow:0 2px 6px #0000000c}.ds-segment:hover{color:var(--ink,#f2f3f7)}.ds-segment:focus-visible{outline:2px solid var(--focus,#8dbbff);outline-offset:4px}"
    },
    {
      "name": "Source-attached Assistance",
      "kind": "custom",
      "refersTo": "inline-ai-trigger",
      "description": "Quiet assistance beneath its current source.",
      "html": "<div class=\"ds-ai-row\"><button class=\"ds-ai\">AI · 总结与扩展</button><span>围绕这里的内容继续思考。</span></div>",
      "css": ".ds-ai-row{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei','PingFang SC',sans-serif;display:flex;align-items:center;flex-wrap:wrap;gap:6px 12px}.ds-ai-row span{font-size:11px;color:var(--muted,#b1b5c2)}.ds-ai{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei','PingFang SC',sans-serif;min-height:36px;padding:7px 13px;border:0;border-radius:22px;background:var(--control,#ffffff10);color:var(--green,#86b9ff);font-size:12px;transition:background-color 160ms}.ds-ai:hover{background:var(--control-hover,#ffffff1c)}.ds-ai:active{transform:scale(.97)}.ds-ai:focus-visible{outline:2px solid var(--focus,#8dbbff);outline-offset:4px}"
    }
  ],
  "narrative": {
    "northStar": "Open Sky / 留一点空间",
    "overview": "LifeAtlas places the owner's writing, evidence and knowledge in a calm personal workspace. The user explicitly selected Apple-inspired visual hierarchy, fluid capsule controls and restrained translucent navigation on 2026-11-03. This replaces the earlier reading-room token system and the unpresented seed 953eaba1 direction. It describes the implemented local web UI, not native macOS or a complete Liquid Glass implementation.\n\nBlue sky and clouds remain the light background; particle stars remain the dark background. Text lives on near-opaque white or charcoal reading surfaces, while navigation and tools use limited frosted material. The original outlined Alegreya LifeAtlas wordmark remains the identity anchor; the selected Aurora Nebula ribbon is the application icon. Geometry stays purposeful: a floating rail, continuous record lists, an independent growth index and a real 3D knowledge canvas.",
    "keyCharacteristics": [
      "Sky and stars surround stable reading surfaces.",
      "Blue primary capsules and quiet secondary actions carry a clear hierarchy.",
      "Chinese system UI type, drawn icons and native form controls stay familiar.",
      "Source-attached AI remains beside the owner’s content."
    ],
    "rules": [
      {
        "name": "The Sky Continuity Rule",
        "body": "Retain day clouds and night stars around the workspace, and retain the deep-space knowledge viewport in both skins.",
        "section": "colors"
      },
      {
        "name": "The Stable Reading Rule",
        "body": "Use frosted material for navigation and tools; keep authored text and form content on near-opaque reading surfaces.",
        "section": "elevation"
      },
      {
        "name": "The Source Stays Rule",
        "body": "Keep AI guidance, previews and generated results beneath the source they concern; do not introduce a separate AI destination.",
        "section": "components"
      }
    ],
    "dos": [
      "Do retain the outlined LifeAtlas wordmark and the original Aurora Nebula icon as separate identity assets.",
      "Do use theme tokens for text, controls, focus and selection in both skins.",
      "Do keep record rows continuous with restrained separators and give the editor its own stable surface.",
      "Do preserve visible written saving, pending, error and selection states alongside color.",
      "Do preserve drafts and source-attached assistance when appearance changes.",
      "Do retain keyboard focus, native fields, reduced-motion and reduced-transparency behavior."
    ],
    "donts": [
      "Don't turn this workspace into a rigid grid of nested dashboard cards.",
      "Don't place long-form text directly on a blurred sky or starfield.",
      "Don't add a standalone AI module or overwrite authored text with generated results.",
      "Don't copy Apple logos, SF font files or SF Symbols, or claim native Apple materials.",
      "Don't use the icon's mint/violet gradients as a new global control palette.",
      "Don't claim installation, real-account connectivity or exhaustive interaction coverage from screenshots."
    ]
  }
}
