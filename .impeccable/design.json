  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary-island",
      "description": "Uiverse-derived expanding layer with an existing-arrow shift; live-bound to either palette, with Island fallback.",
      "html": "<button class=\"ds-button\">保存记录<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:44px;border:1px solid transparent;border-radius:12px;padding:10px 16px;font-size:13px;line-height:1.7;font-weight:500;cursor:pointer;transition:background-color 180ms,border-color 180ms,transform 180ms cubic-bezier(.2,.8,.2,1);font-family:'Microsoft YaHei','PingFang SC',system-ui,sans-serif;background:var(--forest,#abc9f3);border-color:var(--forest,#abc9f3);color:var(--accent-ink,#142238)}.ds-button:hover:not(:disabled){background:var(--forest-deep,#d1e4ff);border-color:var(--forest-deep,#d1e4ff)}.ds-button:focus-visible{outline:3px solid var(--focus,#bedcff);outline-offset:4px}.ds-button:disabled{opacity:.45;cursor:not-allowed} .ds-button{position:relative;isolation:isolate;overflow:hidden;box-shadow:0 4px 10px #253b5814}.ds-button::before{content:\"\";position:absolute;z-index:-1;inset:0 0 0 auto;width:42px;border-radius:inherit;background:#ffffff14;transition:width 240ms cubic-bezier(.2,.8,.2,1);pointer-events:none}.ds-button:hover:not(:disabled)::before{width:100%}.ds-button svg{transition:transform 180ms cubic-bezier(.2,.8,.2,1)}.ds-button:hover:not(:disabled) svg{transform:translateX(3px)}.ds-button:active:not(:disabled){transform:translateY(1px)}@media(prefers-reduced-motion:reduce){.ds-button,.ds-button::before,.ds-button svg{transition:none}.ds-button:active:not(:disabled){transform:none}}"
    },
    {
      "name": "Subtle action",
      "kind": "button",
      "refersTo": "button-subtle",
      "description": "Dark secondary native action with a visible border.",
      "html": "<button class=\"ds-subtle\">取消</button>",
      "css": ".ds-subtle{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:44px;border:1px solid transparent;border-radius:12px;padding:10px 16px;font-size:13px;line-height:1.7;font-weight:500;cursor:pointer;transition:background-color 180ms,border-color 180ms,transform 180ms cubic-bezier(.2,.8,.2,1);font-family:'Microsoft YaHei','PingFang SC',system-ui,sans-serif;background:var(--surface,#101b2ef5);color:var(--ink,#e4edf9);border-color:var(--secondary-border,#536b87)}.ds-subtle:hover:not(:disabled){background:var(--wash,#1b2c45)}.ds-subtle:focus-visible{outline:3px solid var(--focus,#bedcff);outline-offset:4px}.ds-subtle:disabled{opacity:.45;cursor:not-allowed}.ds-subtle:active:not(:disabled){transform:translateY(1px)}@media(prefers-reduced-motion:reduce){.ds-subtle{transition:none}.ds-subtle:active:not(:disabled){transform:none}}"
    },
    {
      "name": "Growth text field",
      "kind": "input",
      "refersTo": "input",
      "description": "Native text entry, with persistence supplied by the application.",
      "html": "<label class=\"ds-label\">下一步<textarea class=\"ds-input\" placeholder=\"写下一个可以尝试的小行动\"></textarea></label>",
      "css": ".ds-label{display:block;font-size:14px;line-height:1.85;color:var(--ink,#e4edf9);font-family:'Microsoft YaHei','PingFang SC',system-ui,sans-serif;}.ds-input{display:block;width:100%;margin-top:8px;min-height:100px;border:1px solid var(--secondary-border,#536b87);border-radius:12px;padding:11px 12px;background:#0b1526;color:var(--ink,#e4edf9);font:15px/1.85 'Microsoft YaHei','PingFang SC',system-ui,sans-serif;resize:vertical;transition:border-color 180ms,box-shadow 180ms;caret-color:var(--green,#b3cefa)}.ds-input::placeholder{color:var(--muted,#aebed2);opacity:1}.ds-input:focus-visible{outline:3px solid var(--focus,#bedcff);outline-offset:4px}@media(max-width:640px){.ds-input{font-size:16px}}@media(prefers-reduced-motion:reduce){.ds-input{transition:none}}"
    },
    {
      "name": "Shared app navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Six core destinations plus independently optional Investment and 人生丰富度. At 641–820px columns match the six to eight visible entries; phones use three columns for six or four for seven/eight.",
      "html": "<nav class=\"ds-nav\" aria-label=\"主导航\"><a href=\"#today\">今日</a><a href=\"#growth\" aria-current=\"page\">个人成长<br><small>环境感知</small></a><a href=\"#knowledge\">知识宇宙</a><a href=\"#mail\">邮箱整理</a><a href=\"#history\">任务记录</a><a href=\"#settings\">偏好设置</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:7px;width:176px;padding:16px;background:#091224b8;font-family:'Microsoft YaHei','PingFang SC',system-ui,sans-serif;}.ds-nav a{display:block;min-height:49px;padding:12px;border-radius:9px;color:var(--rail-ink,#e4edf9);font-size:14px;line-height:1.6;text-decoration:none}.ds-nav small{font-size:12px;font-weight:400}.ds-nav a[aria-current]{color:#fff;background:var(--rail-active,#29476b);font-weight:600}.ds-nav a:hover:not([aria-current]){background:var(--rail-active,#29476b);color:#fff}.ds-nav a:focus-visible{outline:3px solid var(--focus,#bedcff);outline-offset:4px}@media(max-width:820px){.ds-nav{width:auto;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:4px}.ds-nav a{font-size:12px;padding:10px 4px;text-align:center}}@media(max-width:640px){.ds-nav{grid-template-columns:repeat(3,minmax(0,1fr))}}"
    },
    {
      "name": "Topic index selection",
      "kind": "custom",
      "refersTo": "topic-active",
      "description": "A flat independent index, without another enclosing card.",
      "html": "<nav class=\"ds-topics\" aria-label=\"成长主题\"><button>演示主题一（虚构）</button><button aria-current=\"page\">演示主题二（虚构）</button></nav>",
      "css": ".ds-topics{display:flex;flex-direction:column;gap:5px;width:186px;font-family:'Microsoft YaHei','PingFang SC',system-ui,sans-serif;}.ds-topics button{width:100%;min-height:46px;background:transparent;border:0;border-radius:12px;padding:13px 11px;text-align:left;font:13px/1.85 'Microsoft YaHei','PingFang SC',system-ui,sans-serif;color:var(--muted,#aebed2);cursor:pointer;overflow-wrap:anywhere;transition:background-color 180ms}.ds-topics button[aria-current]{background:var(--nav-active-bg,#263e5e);color:var(--green,#b3cefa);font-weight:600}.ds-topics button:hover:not([aria-current]){background:var(--wash,#1b2c45);color:var(--ink,#e4edf9)}.ds-topics button:focus-visible{outline:3px solid var(--focus,#bedcff);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-topics button{transition:none}}"
    },
    {
      "name": "Pending status",
      "kind": "chip",
      "refersTo": "status-awaiting",
      "description": "Noninteractive status with explicit written meaning.",
      "html": "<span class=\"ds-status\">待确认</span>",
      "css": ".ds-status{display:inline-block;padding:4px 8px;border-radius:5px;background:var(--amber-bg,#3c3124);color:var(--amber,#ecd1a1);font-size:12px;line-height:1.8;font-family:'Microsoft YaHei','PingFang SC',system-ui,sans-serif;}"
    },
    {
      "name": "Continuous reading sheet",
      "kind": "card",
      "refersTo": "growth-reading-sheet",
      "description": "One near-opaque dark sheet, with flat ruled content rather than nested cards.",
      "html": "<section class=\"ds-sheet\"><h2>个人成长</h2><p>写下经历，再回看理解如何变化。</p><details><summary>观察、理解与尝试</summary><p>次要内容按需展开。</p></details></section>",
      "css": ".ds-sheet{background:var(--surface,#101b2ef5);color:var(--ink,#e4edf9);padding:26px 28px;border-radius:14px;box-shadow:var(--shadow,0 12px 38px #01040b40);font-family:'Microsoft YaHei','PingFang SC',system-ui,sans-serif;}.ds-sheet h2{font-size:20px;font-weight:600;line-height:1.75;margin:0 0 20px}.ds-sheet p{font-size:16px;line-height:1.95;margin:0;max-width:70ch}.ds-sheet details{margin-top:22px;padding-top:12px;border-top:1px solid var(--line,#314159)}.ds-sheet summary{padding:9px 0;color:var(--green,#b3cefa);font-size:13px;cursor:pointer}.ds-sheet summary:hover{text-decoration:underline}.ds-sheet summary:focus-visible{outline:3px solid var(--focus,#bedcff);outline-offset:3px}.ds-sheet details p{font-size:14px}@media(max-width:640px){.ds-sheet{padding:22px 18px}}"
    },
    {
      "name": "Appearance controls",
      "kind": "custom",
      "refersTo": "input",
      "description": "Settings-only native two-palette selector and dynamic-sky switch; the application supplies synchronization, static-off behavior and pause rules.",
      "html": "<div class=\"ds-appearance\"><label>皮肤 <select aria-label=\"选择皮肤\"><option value=\"island\">光屿工作台</option><option value=\"observatory\">对页观察室</option></select></label><label class=\"ds-particle\"><input type=\"checkbox\" checked><span class=\"ds-track\" aria-hidden=\"true\"><span class=\"ds-knob\"></span></span><span>星空动态</span></label></div>",
      "css": ".ds-appearance{display:flex;flex-wrap:wrap;align-items:center;gap:12px 16px;font-size:12px;font-family:\"Microsoft YaHei\",\"PingFang SC\",system-ui,sans-serif}.ds-appearance label{display:inline-flex;align-items:center;gap:8px;min-height:40px;color:var(--muted,#aebed2)}.ds-appearance select{max-width:100%;min-height:40px;border:1px solid var(--secondary-border,#536b87);border-radius:12px;padding:8px 30px 8px 12px;background:var(--surface,#101b2ef5);color:var(--ink,#e4edf9);font:inherit}.ds-appearance .ds-particle{position:relative;gap:10px;min-height:44px;cursor:pointer}.ds-particle>input{position:absolute;inset:0;width:100%;height:100%;opacity:0;margin:0;z-index:1;cursor:pointer}.ds-track{position:relative;display:block;flex:none;width:44px;height:26px;border-radius:20px;background:var(--secondary-border,#536b87);transition:background-color 180ms;pointer-events:none}.ds-knob{position:absolute;left:3px;bottom:3px;height:20px;width:20px;border-radius:50%;background:var(--surface,#101b2ef5);box-shadow:0 2px 4px #253b5820;transition:transform 180ms cubic-bezier(.2,.8,.2,1)}.ds-particle>input:checked+.ds-track{background:var(--forest,#abc9f3)}.ds-particle>input:checked+.ds-track .ds-knob{transform:translateX(18px)}.ds-appearance select:focus-visible,.ds-particle>input:focus-visible+.ds-track{outline:3px solid var(--focus,#bedcff);outline-offset:4px}.ds-particle>input:disabled~span{opacity:.5}@media(max-width:640px){.ds-appearance{font-size:13px}.ds-appearance select{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-track,.ds-knob{transition:none}}@media(forced-colors:active){.ds-track{border:1px solid ButtonText}.ds-knob{background:ButtonText}}"
    },
    {
      "name": "Facing periods",
      "kind": "custom",
      "refersTo": "comparison-cool",
      "description": "Earlier/later labels only; real excerpts come from authored records.",
      "html": "<div class=\"ds-compare\"><section><h3>较早记录</h3><p>经历与反省</p></section><section><h3>较近记录</h3><p>经历与反省</p></section></div>",
      "css": ".ds-compare{display:grid;grid-template-columns:1fr 1fr;gap:20px;color:var(--ink,#e4edf9);font-family:'Microsoft YaHei','PingFang SC',system-ui,sans-serif;}.ds-compare section{min-width:0;padding:20px;border-radius:12px;background:var(--wash,#1b2c45)}.ds-compare section+section{background:var(--wash,#1b2c45)}.ds-compare h3{font-size:14px;line-height:1.8;color:var(--green,#b3cefa);margin:0 0 12px}.ds-compare p{font-family:AtlasSerif,'Noto Serif SC',serif;font-size:18px;line-height:1.95;margin:0;overflow-wrap:anywhere}@media(max-width:640px){.ds-compare{grid-template-columns:1fr;gap:18px}.ds-compare section{padding:20px 16px}}"
    },
    {
      "name": "Embedded knowledge tools",
      "kind": "custom",
      "description": "Compact module toolbar under the host LifeAtlas heading; no duplicate brand or sidebar. Real map and backup behavior remain in the application.",
      "html": "<div class=\"ds-knowledge-tools\"><label>星系 <select aria-label=\"星系\"><option>六大星系</option><option>数学</option><option>物理</option></select></label><button>学习路线</button><button>收藏</button><button>导出</button><button>导入</button></div>",
